{
  "name": "Pandora-Box",
  "productName": "Pandora-Box",
  "version": "1.1.0",
  "description": "A Simple Mihomo GUI",
  "author": {
    "name": "snakem982",
    "email": "127644738+snakem982@users.noreply.github.com"
  },
  "main": "dist/electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:renderer": "vite build --config vite.config.ts",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "start": "npm run build && concurrently -k \"npm:dev\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "package": "npm run build && electron-builder --config electron-builder.config.cjs --dir",
    "make": "npm run build && electron-builder --config electron-builder.config.cjs"
  },
  "license": "GPL-3.0",
